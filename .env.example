# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development                        # development | production | test
PORT=3000
CLIENT_URL=http://localhost:5173            # Frontend origin (used by CORS)

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://user:password@localhost:5432/gdrive_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379            # Used for session store

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://user:password@localhost:5672

# ── JWT & Sessions ────────────────────────────────────────────────────────────
JWT_SECRET=                                 # Min 32 chars — generate with: openssl rand -hex 32
JWT_EXPIRY=7d                               # e.g. 15m, 1h, 7d
SESSION_TTL_SECONDS=604800                  # 7 days in seconds

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your_api_url>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# IAM user needs: s3:PutObject, s3:GetObject, s3:DeleteObject on your bucket
AWS_REGION=ap-south-1                       # e.g. us-east-1, ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=                              # Keep bucket private — files served via presigned URLs
PRESIGNED_URL_EXPIRES=900                   # Seconds — 900 = 15 minutes

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=1073741824              # 1073741824 = 1 GB
MULTIPART_CHUNK_SIZE_BYTES=10485760        # 10485760 = 10 MB per chunk
DEFAULT_USER_QUOTA_BYTES=2147483648        # 2147483648 = 2 GB per user
